# ========================================
# Django Configuration
# ========================================
# Allowed hosts for HTTP/WebSocket connections (comma-separated)
# IMPORTANT: Set this to your actual domain/IP in production for security
# Example: ALLOWED_HOSTS=ai-med.example.com,192.168.1.100
ALLOWED_HOSTS=localhost,127.0.0.1

# ========================================
# Database Configuration
# ========================================
POSTGRES_USER=aimedical
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=aimedical_db

# ========================================
# SSL/TLS Configuration
# ========================================
# Option 1: Auto-generate self-signed certificates (default)
# Leave SSL_CERT_PATH and SSL_KEY_PATH empty to auto-generate
# CA certificate (ca.crt) will be generated in certs/ directory
# Distribute ca.crt to client devices for trust

# Option 2: Use organizational CA-signed certificates
# Specify paths to your CA-signed certificates
# SSL_CERT_PATH=/path/to/your/server.crt
# SSL_KEY_PATH=/path/to/your/server.key
SSL_CERT_PATH=
SSL_KEY_PATH=

# Server hostname for certificate SubjectAltName
# Default: localhost
# Example: SERVER_NAME=ai-med.example.com
SERVER_NAME=localhost

# Additional IP addresses for certificate SubjectAltName (comma-separated)
# Example: SERVER_IPS=192.168.1.100,10.0.0.50
SERVER_IPS=

# ========================================
# AmiVoice Configuration
# ========================================
AMIVOICE_API_URL=wss://acp-api.amivoice.com/v1/nolog/
AMIVOICE_API_KEY=your_amivoice_api_key_here
AMIVOICE_GRAMMAR=-a-medical

# ========================================
# LLM Configuration (liteLLM)
# ========================================
# 使用するモデル（liteLLMのモデル名形式）
LLM_MODEL=bedrock/anthropic.claude-3-sonnet-20240229-v1:0

# liteLLM API Base URL（カスタムエンドポイント使用時）
# LITELLM_API_BASE=https://your-litellm-proxy.com

# AWS Bedrock credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# OpenAI API Key (if using OpenAI)
# OPENAI_API_KEY=your_openai_api_key

# Anthropic API Key (if using Anthropic directly)
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ========================================
# Security Configuration
# ========================================
# SECRET_KEY is auto-generated on first startup
HMAC_SECRET=your_hmac_secret_key_here_minimum_32_chars

# ========================================
# Session Configuration
# ========================================
SESSION_TIMEOUT_HOURS=3
