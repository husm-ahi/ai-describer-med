"""
Admin configuration for core application.
"""
from django.contrib import admin
from django.contrib.auth.admin import UserAdmin as BaseUserAdmin
from django.contrib.auth.models import User
from django.utils.html import format_html
from django.urls import reverse
from django.utils import timezone
from datetime import timedelta
from .models import SystemPrompt, LLMLog, AuditLog
import secrets


class SystemPromptAdmin(admin.ModelAdmin):
    """Admin interface for System Prompts."""
    list_display = ['version', 'is_active', 'created_by', 'created_at']
    list_filter = ['is_active', 'created_at']
    search_fields = ['version', 'content']
    readonly_fields = ['created_at', 'created_by']
    
    fieldsets = (
        (None, {
            'fields': ('version', 'content', 'is_active')
        }),
        ('Metadata', {
            'fields': ('created_by', 'created_at'),
            'classes': ('collapse',)
        }),
    )
    
    def save_model(self, request, obj, form, change):
        """Set created_by to current user on creation."""
        if not change:
            obj.created_by = request.user
        super().save_model(request, obj, form, change)
        
        # Log the action
        action = 'prompt_updated' if change else 'prompt_created'
        AuditLog.log_action(
            action=action,
            admin=request.user,
            version=obj.version
        )


class LLMLogAdmin(admin.ModelAdmin):
    """Admin interface for LLM Logs."""
    list_display = ['id', 'user_hash', 'model_name', 'prompt_version', 'processing_time_ms', 'created_at']
    list_filter = ['model_name', 'prompt_version', 'created_at']
    search_fields = ['user_hash', 'user_prompt', 'llm_response']
    readonly_fields = ['user_hash', 'user_prompt', 'llm_response', 'model_name', 
                       'prompt_version', 'processing_time_ms', 'created_at']
    date_hierarchy = 'created_at'
    
    fieldsets = (
        ('Log Information', {
            'fields': ('id', 'user_hash', 'created_at')
        }),
        ('Request', {
            'fields': ('user_prompt',)
        }),
        ('Response', {
            'fields': ('llm_response', 'model_name', 'prompt_version', 'processing_time_ms')
        }),
    )
    
    def has_add_permission(self, request):
        """Disable manual creation of logs."""
        return False
    
    def has_change_permission(self, request, obj=None):
        """Make logs read-only."""
        return False
    
    actions = ['delete_old_logs']
    
    def delete_old_logs(self, request, queryset):
        """Delete logs older than specified days."""
        # This will be implemented with a custom admin action
        pass
    delete_old_logs.short_description = "Delete logs older than N days"


class AuditLogAdmin(admin.ModelAdmin):
    """Admin interface for Audit Logs."""
    list_display = ['id', 'action', 'admin_link', 'target_user_link', 'created_at']
    list_filter = ['action', 'created_at']
    search_fields = ['action', 'admin__username', 'target_user__username']
    readonly_fields = ['action', 'admin', 'target_user', 'details', 'created_at']
    date_hierarchy = 'created_at'
    
    fieldsets = (
        ('Action', {
            'fields': ('action', 'created_at')
        }),
        ('Users', {
            'fields': ('admin', 'target_user')
        }),
        ('Details', {
            'fields': ('details',)
        }),
    )
    
    def admin_link(self, obj):
        """Display clickable link to admin user."""
        if obj.admin:
            url = reverse('admin:auth_user_change', args=[obj.admin.pk])
            return format_html('<a href="{}">{}</a>', url, obj.admin.username)
        return '-'
    admin_link.short_description = 'Admin'
    
    def target_user_link(self, obj):
        """Display clickable link to target user."""
        if obj.target_user:
            url = reverse('admin:auth_user_change', args=[obj.target_user.pk])
            return format_html('<a href="{}">{}</a>', url, obj.target_user.username)
        return '-'
    target_user_link.short_description = 'Target User'
    
    def has_add_permission(self, request):
        """Disable manual creation of audit logs."""
        return False
    
    def has_change_permission(self, request, obj=None):
        """Make audit logs read-only."""
        return False
    
    def has_delete_permission(self, request, obj=None):
        """Disable deletion of audit logs."""
        return False


class CustomUserAdmin(BaseUserAdmin):
    """Enhanced User Admin with additional features."""
    actions = ['disable_users']
    
    def disable_users(self, request, queryset):
        """Disable selected users by setting random password and is_active=False."""
        for user in queryset:
            if not user.is_superuser:  # Don't disable superusers
                random_password = secrets.token_urlsafe(48)
                user.set_password(random_password)
                user.is_active = False
                user.save()
                
                # Log the action
                AuditLog.log_action(
                    action='user_disabled',
                    admin=request.user,
                    target_user=user
                )
        
        self.message_user(request, f"{queryset.count()} user(s) disabled successfully.")
    disable_users.short_description = "Disable selected users"


# Register models
admin.site.register(SystemPrompt, SystemPromptAdmin)
admin.site.register(LLMLog, LLMLogAdmin)
admin.site.register(AuditLog, AuditLogAdmin)

# Unregister default User admin and register custom one
admin.site.unregister(User)
admin.site.register(User, CustomUserAdmin)
